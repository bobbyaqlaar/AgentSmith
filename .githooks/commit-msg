#!/usr/bin/env bash
# .githooks/commit-msg — AgentSmith's OWN commit gate (docs/process-gates.md).
#
# Armed per clone with:  git config core.hooksPath .githooks
#
# This repository does not use the tenant hooks in hooks/: it is the framework,
# not a tenant, and hooks/post-commit pushes on its own. Replacing the hooks
# path with /dev/null to avoid that push also skipped every check — which is how
# commits here went out with no gate at all.
#
# The same check runs in CI over every pushed commit (Self-Test
# "process-gates"), so a clone without this hook armed is caught there.
set -euo pipefail

msg_file="$1"
subject=$(grep -v '^#' "$msg_file" | head -n 1)
if [[ ! "$subject" =~ ^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9_/-]+\))?!?:\ .{1,72}$ ]]; then
  echo "❌ commit blocked: subject must be a Conventional Commit, ≤72 chars after the type" >&2
  echo "   got: \"$subject\"" >&2
  exit 1
fi

# `git commit --amend` compares the index with the commit being REPLACED, so an
# amend that changes only the message looked like a commit with no changes and
# passed without trailers. Git does not tell a hook it is amending; the parent
# process's arguments do. (If ps is unavailable the check degrades to the plain
# commit's view — CI still checks the amended commit in full.)
amend=()
if ps -o args= -p "$PPID" 2>/dev/null | grep -qE '(^|[[:space:]])--amend([[:space:]]|$)'; then
  amend=(--amend)
fi

exec python3 "$(git rev-parse --show-toplevel)/scripts/process_gate.py" commit-msg "${amend[@]+"${amend[@]}"}" "$msg_file"
