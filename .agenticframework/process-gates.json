{
  "_about": "What the process gates cover in this repository \u2014 scripts/process_gate.py, docs/process-gates.md. This file is gated itself.",
  "gated": [
    "scripts/**",
    "runtime/**",
    "hooks/**",
    "portal/**",
    "workflow-templates/**",
    ".github/**",
    "templates/**",
    "contract/**",
    "enterprise/**",
    "examples/**",
    "fixtures/**",
    "init-db/**",
    "caddy/**",
    ".githooks/**",
    "install-ai-stack.sh",
    "pyproject.toml",
    "pytest.ini",
    "requirements*.txt",
    "requirements*.lock",
    ".python-version",
    "docker-compose*.yml",
    ".claude/settings.json",
    ".cursor/**",
    ".agents/hooks.json",
    ".gemini/settings.json",
    ".codex/hooks.json",
    ".agenticframework/process-gates.json"
  ],
  "not_gated": [
    "**.md",
    ".agent-rfc/**",
    "**/node_modules/**"
  ],
  "registry": "@framework/templates/governance.json",
  "artifacts": "enforce",
  "knowledge_graph": "enforce",
  "pillars": {
    "_about": "Whether this repo is held to the pillars a script can check (G6). The allowlist only shrinks: a new entry needs an approval the owner records in a terminal, and the mode may not be weakened.",
    "mode": "enforce",
    "allow": [
      {
        "check": "P3-tracing",
        "path": ".github/scratch-tenants/apps/python-fastapi/app/main.py",
        "why": "liveness probe in a generated tenant scaffold \u2014 a span per kubelet probe is noise, not observability"
      },
      {
        "check": "P3-tracing",
        "path": ".github/scratch-tenants/apps/python-uv/app/main.py",
        "why": "liveness probe in a generated tenant scaffold \u2014 a span per kubelet probe is noise, not observability"
      }
    ]
  },
  "levers_doc": "docs/review-levers.md",
  "design_checklist": "docs/design-review-checklist.md",
  "changelog": {
    "_about": "Paths a tenant receives. Kept equal to what .github/workflows/scratch-tenants.yml rebuilds tenants on (test_process_gate.py), minus that workflow's two own entries.",
    "file": "CHANGELOG.md",
    "paths": [
      "hooks/**",
      "install-ai-stack.sh",
      "workflow-templates/**",
      ".github/actions/**",
      "scripts/**",
      "runtime/**",
      "fixtures/**",
      "templates/agent-rules.yaml",
      "templates/governance.json"
    ],
    "except": [
      "scripts/test/**",
      "runtime/test/**"
    ]
  },
  "extends": {
    "artifacts": {
      "reference": [
        "contract/gate/v1/protocol.md",
        "contract/gate/v2/protocol.md",
        "contract/gate/v3/protocol.md",
        "contract/record/v1/protocol.md",
        "contract/rules/v1/protocol.md",
        "contract/telemetry/v1/protocol.md"
      ]
    }
  }
}
