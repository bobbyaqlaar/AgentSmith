# AgentSmith — Org Policy File (docs/DESIGN.md › Enterprise Install and Compliance Pack, enterprise pack).
#
# IT authors this file and deploys it through its own MDM to
# ~/.agent-framework/agenticframework-org.yaml on every managed machine
# (enterprise/README.md). `agentsmith mode off` reads it to enforce
# bypass_policy (runtime/machine/policy.py), and a repository's gate, while it
# is present, adds the RFC checks (docs/process-gates.md › commit_guardrails).

hooks:
  version: "1.0.0"
  # disabled    — `agentsmith mode off` is refused. (A repository's own gate
  #               has no bypass to ask about: --no-verify is caught in CI.)
  # break-glass — a bypass is allowed ONLY with a valid AI_BREAK_GLASS_TOKEN
  #               signed with BREAK_GLASS_HMAC_KEY, issued by IT per incident.
  #               Every use (granted or denied) is written to the
  #               enterprise audit log (see portal/lib/auditLog.ts, §30).
  bypass_policy: disabled
  break_glass_approvers: ["it-sec@example.com"]

phoenix:
  endpoint: "https://phoenix.corp.internal"
  auth: oidc

sso:
  provider: okta
  issuer: "https://corp.okta.com"
  client_id: "REPLACE_ME"

# Best-effort audit log write target (see runtime/machine/policy.py's
# audit_log_event and portal/app/api/audit/append/route.ts). Optional —
# if unset, hook_bypass events are still enforced locally, just not logged
# centrally.
audit:
  ops_portal_url: "https://ops.corp.internal"
  # The write token itself is NOT stored here — set AUDIT_LOG_WRITE_TOKEN in
  # the environment (e.g. via MDM-managed environment configuration), never
  # commit it to this file.
