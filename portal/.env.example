# Ops Portal configuration (SPECS.md §15, §26)
#
# ⚠️  Docker Compose .env rules: values are raw strings — do NOT surround
# values with quotes. KEY="value" sets the value to literally "value" (with
# quotes). Use bare values only: KEY=value

# Same Postgres instance used by runtime/llm_gateway.py's budget backend
DATABASE_URL=postgresql://phoenix:phoenix@localhost:5433/agenticframework

# Dashboard basic auth — required, the portal refuses to serve without these
OPS_PORTAL_USER=ops
OPS_PORTAL_PASSWORD=change-me

# Bearer token tenant CD pipelines use to POST /api/sync/history
OPS_PORTAL_SYNC_TOKEN=change-me-too

# Audit log (SPECS.md §30, enterprise pack) — append-only, HMAC-signed
AUDIT_LOG_WRITE_TOKEN=change-me-three
AUDIT_LOG_HMAC_KEY=change-me-four-this-one-especially

# SSO/OIDC (SPECS.md §30, enterprise pack) — set SSO_ENABLED=true to REPLACE
# basic auth above with OIDC login. Leave SSO_ENABLED unset/false to keep
# using OPS_PORTAL_USER/PASSWORD (the default, non-enterprise setup).
# SSO_ENABLED=true
# SSO_ISSUER=https://corp.okta.com
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_REDIRECT_URI=https://ops.example.com/api/auth/callback
# SSO_SESSION_SECRET=
# SSO_ALLOW_INSECURE_HTTP=false  # local dev/test against a non-TLS IdP ONLY
# SSO_REVOCATION_MODE=fail-open  # or fail-closed → 503 when session-status unreachable (SEC-SSO-001)

# Eval gates (run-evals.py suites — same load pattern as tenant .env)
# Hallucination suite hard-fail when flagged rate exceeds threshold (default 5%)
HALLUCINATION_FAIL_ABOVE=0.05

# TTFT live gate (scripts/verify_ttft.py — Ollama streaming)
TTFT_FAIL_ABOVE_MS=2000
# TTFT_LIVE=required  # repo variable — enable live Ollama job

# Tracing (optional). Point at the same collector the workers export to and the
# portal's request handling, its Postgres queries and its outbound Phoenix calls
# join the worker's trace — the `traceparent` on POST /api/runs/ingest becomes
# the parent of the portal's spans. Unset, no provider is registered at all and
# the portal behaves exactly as it did before it was instrumented.
#
# A base URL and a full /v1/traces URL both work: ai-dashboard-start exports the
# latter, and the JS exporter would otherwise append a second copy of the path.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=   # traces-only override; used as-is, wins over the above
#
# Set these to the SAME values the workers use, or the two sides label one
# deployment two ways. ENVIRONMENT fails closed to "production" when unset.
# ENVIRONMENT=development
# AGENT_PROJECT_NAME=agentsmith
# AGENT_OWNER_ID=you@example.com
