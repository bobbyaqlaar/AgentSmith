{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsmith.dev/contract/evals/v1/dataset.hallucination.schema.json",
  "description": "The tenant's hallucination dataset: a list of cases, at the path contract/evals/v1/protocol.md names. A case may carry keys of its own.",
  "type": "array",
  "items": {
    "$ref": "#/$defs/HallucinationCase"
  },
  "$defs": {
    "ContextDocument": {
      "additionalProperties": true,
      "description": "One retrieved document, as a retrieval layer produces it: the judge\nquotes its `text` under its `id` (or `title`).",
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "text"
      ],
      "title": "ContextDocument",
      "type": "object"
    },
    "HallucinationCase": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "input": {
          "minLength": 1,
          "title": "Input",
          "type": "string"
        },
        "actual_output": {
          "minLength": 1,
          "title": "Actual Output",
          "type": "string"
        },
        "reference_output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Output"
        },
        "expected_tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Tool"
        },
        "retrieved_context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/ContextDocument"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved Context"
        },
        "expect_hallucination": {
          "default": false,
          "title": "Expect Hallucination",
          "type": "boolean"
        },
        "score_hallucination": {
          "default": true,
          "title": "Score Hallucination",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "input",
        "actual_output"
      ],
      "title": "HallucinationCase",
      "type": "object"
    }
  }
}
