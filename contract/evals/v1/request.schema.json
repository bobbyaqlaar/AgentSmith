{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsmith.dev/contract/evals/v1/request.schema.json",
  "description": "What a caller sends on stdin. Unknown keys are ignored.",
  "additionalProperties": true,
  "properties": {
    "suite": {
      "enum": [
        "golden",
        "fairness",
        "hallucination",
        "adversarial",
        "rag_poison"
      ],
      "title": "Suite",
      "type": "string"
    },
    "fail_below": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fail Below"
    },
    "fail_above": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fail Above"
    },
    "cwd": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cwd"
    }
  },
  "required": [
    "suite"
  ],
  "title": "EvalsRequest",
  "type": "object"
}
