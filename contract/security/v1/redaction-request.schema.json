{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsmith.dev/contract/security/v1/redaction-request.schema.json",
  "additionalProperties": true,
  "description": "What a caller sends `redaction` on stdin. Unknown keys are ignored.",
  "properties": {
    "environment": {
      "enum": [
        "staging",
        "production"
      ],
      "title": "Environment",
      "type": "string"
    },
    "emitter": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Emitter"
    },
    "cwd": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cwd"
    }
  },
  "required": [
    "environment"
  ],
  "title": "RedactionRequest",
  "type": "object"
}
