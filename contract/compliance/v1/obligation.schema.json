          "type": "array"
        },
        "iso42001_theme": {
          "items": {
            "type": "integer"
          },
          "title": "Iso42001 Theme",
          "type": "array"
        },
        "uae_charter": {
          "items": {
            "type": "string"
          },
          "title": "Uae Charter",
          "type": "array"
        },
        "dubai_ethics": {
          "items": {
            "type": "string"
          },
          "title": "Dubai Ethics",
          "type": "array"
        },
        "owasp_llm": {
          "items": {
            "type": "string"
          },
          "title": "Owasp Llm",
