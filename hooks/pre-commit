#!/usr/bin/env bash
# AgentSmith: pre-commit guardrail
# Blocks unresolved AI markers, empty catch blocks, and unsafe Go patterns.

# ── Bypass ─────────────────────────────────────────────────────────────────────
# Requested by DISABLE_AI_STACK=true for one command, or `agentsmith mode off`
# for the machine. With no enterprise org policy it is granted. With one, the
# policy decides (runtime/machine/policy.py) and records the attempt; refused —
# or unable to ask — this hook runs as normal. Identical in all four hooks
# (scripts/test/test_hook_bypass.py).
AF_STATE_DIR="${AGENTSMITH_STATE_DIR:-$HOME/.agent-framework/state}"
if [ "${DISABLE_AI_STACK:-false}" = "true" ] || [ "$(cat "$AF_STATE_DIR/mode" 2>/dev/null)" = "disabled" ]; then
  [ -f "$HOME/.agent-framework/agenticframework-org.yaml" ] || exit 0
  "$HOME/.agent-framework/.venv/bin/agentsmith" hooks bypass-check && exit 0
  echo "AgentSmith: hook bypass refused by the org policy — this hook runs as normal." >&2
fi

# ── Developer opt-in gate ──────────────────────────────────────────────────────
# git's global init.templateDir applies these hooks to EVERY `git init`/
# `git clone` on the machine — including repos that have nothing to do with
# AgentSmith. post-checkout writes .agenticframework/enabled the first
# time it provisions a repo (or tenant.yaml already exists, for
# multi-tenancy repos) — until one of those exists, this guardrail no-ops
# rather than blocking commits in an unrelated repo.
REPO_ROOT_FOR_OPTIN=$(git rev-parse --show-toplevel 2>/dev/null)
ORG_POLICY_FILE="$HOME/.agent-framework/agenticframework-org.yaml"
if [ -n "$REPO_ROOT_FOR_OPTIN" ] \
   && [ ! -f "$REPO_ROOT_FOR_OPTIN/.agenticframework/enabled" ] \
   && [ ! -f "$REPO_ROOT_FOR_OPTIN/.agenticframework/tenant.yaml" ] \
   && [ ! -f "$ORG_POLICY_FILE" ]; then
  exit 0
fi

FAILED=0
STAGED=$(git diff --cached --name-only --diff-filter=d 2>/dev/null)
[ -z "$STAGED" ] && exit 0

echo "🚨 AgentSmith: Running pre-commit guardrails..."

# ── What the tenant did not write ────────────────────────────────────────────
# A tenant's staged files include the scripts/ and runtime/ AgentSmith vendored
# into it. Reporting a defect in those to a tenant asks them to fix code they do
# not own, and it blocked every scaffolded repo's first commit until 2026-09-29
# (.agent-rfc/designs/scaffold-rfc-and-vouched-skip.md). Guardrails 1-3 skip a
# staged file that .agenticframework/scaffold.json vouches for AND that still
# hashes to what the manifest recorded — edit a vendored file and it is checked
# again. The rules still run over this code, in AgentSmith's own suite, where it
# can be fixed (scripts/test/test_bare_except_tree.py, test_vendored_markers.py).
#
# Resolved like check_bare_except.py below: the machine install first, then the
# repo's own copy. Missing script, missing python3, missing or unreadable
# manifest — VOUCHED stays empty and every file is checked, which is what this
# hook did before. A skip is only ever granted by a hash that matched.
VOUCHED=""
VOUCHER=""
if [ -f "$HOME/.agent-framework/scripts/vouched_files.py" ]; then
  VOUCHER="$HOME/.agent-framework/scripts/vouched_files.py"
elif [ -n "$REPO_ROOT_FOR_OPTIN" ] && [ -f "$REPO_ROOT_FOR_OPTIN/scripts/vouched_files.py" ]; then
  VOUCHER="$REPO_ROOT_FOR_OPTIN/scripts/vouched_files.py"
fi
if [ -n "$VOUCHER" ] && command -v python3 >/dev/null 2>&1; then
  VOUCHED=$(python3 "$VOUCHER" 2>/dev/null)
fi
VOUCHED_COUNT=$(printf '%s' "$VOUCHED" | grep -c . || true)
if [ "${VOUCHED_COUNT:-0}" -gt 0 ]; then
  # Indented: build.sh fails a tenant build on any column-0 warning, and this is
  # not one. Said out loud all the same — a file nobody checked must not read
  # the same as a file that passed.
  echo "   ℹ️  $VOUCHED_COUNT staged file(s) are AgentSmith's own, unchanged since it wrote them — not checked here"
fi

# True when $1 is vouched for. Exact line match: a path is never a prefix or a
# glob of another.
is_vouched() {
  [ -n "$VOUCHED" ] && printf '%s\n' "$VOUCHED" | grep -qxF "$1"
}

# ── Guardrail 1: Unresolved AI shortcut markers ──────────────────────────────
# Over the tenant's own files only — see "What the tenant did not write" above.
STAGED_OWN=""
while IFS= read -r file; do
  [ -n "$file" ] || continue
  is_vouched "$file" || STAGED_OWN="$STAGED_OWN$file
"
done <<< "$STAGED"
if [ -n "$STAGED_OWN" ] && echo "$STAGED_OWN" | xargs grep -E -I -l "(ponytail:|TODO: agent|@agent-ignore)" /dev/null 2>/dev/null | grep -q .; then
  echo "$STAGED_OWN" | xargs grep -E -I -n "(ponytail:|TODO: agent|@agent-ignore)" /dev/null 2>/dev/null || true
  echo "❌ ERROR: Commit blocked. Unresolved AI marker found (ponytail: / TODO: agent / @agent-ignore)."
  echo "   Resolve the marker before committing."
  FAILED=1
fi

# ── Guardrail 2: Empty catch/except blocks ────────────────────────────────────
while IFS= read -r file; do
  # An `if`, not `is_vouched ... && continue`: on a tenant's first commit the
  # skip is the common path, and that one-liner returns 1 when it does NOT skip
  # — fatal the day anyone adds `set -e` to this hook.
  if is_vouched "$file"; then continue; fi
  case "$file" in
    *.ts|*.tsx|*.js|*.jsx)
      if grep -E -n "catch\s*\([^)]*\)\s*\{\s*\}" "$file" 2>/dev/null; then
        echo "❌ ERROR ($file): Empty catch block. Swallowing errors is a safety violation."
        FAILED=1
      fi
      ;;
    *.py)
      # AST-based (not regex) — a regex matching "except X:$" flags the
      # HEADER line of every multi-line handler, since the colon always
      # ends the line regardless of what's in the body underneath. Only
      # scripts/check_bare_except.py's actual syntax-tree walk can tell a
      # genuinely empty `pass`/`...` body apart from a normal handler that
      # re-raises or logs on the next line. Vendored to
      # ~/.agent-framework/scripts/ for tenant repos; falls back to a
      # repo-local copy when running inside this framework repo itself.
      # Missing checker = skip (optional infra never blocks a commit).
      BARE_EXCEPT_CHECKER=""
      if [ -f "$HOME/.agent-framework/scripts/check_bare_except.py" ]; then
        BARE_EXCEPT_CHECKER="$HOME/.agent-framework/scripts/check_bare_except.py"
      elif [ -f "$REPO_ROOT_FOR_OPTIN/scripts/check_bare_except.py" ]; then
        BARE_EXCEPT_CHECKER="$REPO_ROOT_FOR_OPTIN/scripts/check_bare_except.py"
      fi
      if [ -n "$BARE_EXCEPT_CHECKER" ] && command -v python3 >/dev/null 2>&1; then
        if ! python3 "$BARE_EXCEPT_CHECKER" "$file"; then
          echo "❌ ERROR ($file): empty except handler. Log or re-raise all exceptions."
          FAILED=1
        fi
      fi
      ;;
    *.go)
      if grep -E -n "^[[:space:]]*_\s*,\s*_\s*:?=" "$file" 2>/dev/null; then
        echo "❌ ERROR ($file): Double blank identifier. Idiomatic Go forbids ignoring both return values."
        FAILED=1
      fi
      ;;
  esac
done <<< "$STAGED"

# ── Guardrail 3: direct cost_router imports in runtime/ (enterprise mode) ────
# docs/DESIGN.md line 1618: "workers MUST NOT import cost_router.py directly" — that
# rule previously existed only as a comment in runtime/llm_gateway.py and
# runtime/worker.py, with nothing actually enforcing it (docs/PRODUCT_BACKLOG.md
# 1.3). Any call routed through cost_router.py bypasses the per-tenant budget
# store, degrade ladder, and audit trail entirely. Enterprise mode = an org
# policy file exists at ~/.agent-framework/agenticframework-org.yaml.
if [ -f "$ORG_POLICY_FILE" ]; then
  while IFS= read -r file; do
    if is_vouched "$file"; then continue; fi
    case "$file" in
      runtime/*.py)
        if grep -E -n "^[[:space:]]*(import[[:space:]]+cost_router|from[[:space:]]+(scripts\.)?cost_router[[:space:]]+import|from[[:space:]]+scripts[[:space:]]+import[[:space:]]+cost_router)" "$file" 2>/dev/null; then
          echo "❌ ERROR ($file): direct cost_router import inside runtime/. Workers MUST go through"
          echo "   runtime/llm_gateway.py — importing cost_router.py directly bypasses budget"
          echo "   enforcement, the degrade ladder, and the audit trail entirely (docs/DESIGN.md line 1618)."
          FAILED=1
        fi
        ;;
    esac
  done <<< "$STAGED"
fi

# ── Guardrail 4: enterprise RFC tracking must exist (enterprise mode) ───────
# docs/PRODUCT_ARCHIVE.md P1a: "If org policy present: require RFC-NNN in
# commit message or staged paths covered by open .agent-rfc/*.md." The
# RFC-NNN-in-commit-message half of that check lives in hooks/commit-msg
# instead — pre-commit has no access to the (not-yet-written) commit
# message, only the staged diff. This guardrail enforces the part
# pre-commit *can* see: that this repo has at least one open RFC at all
# under enterprise policy, not whether this specific commit references one
# by number (that's commit-msg's job).
if [ -f "$ORG_POLICY_FILE" ]; then
  RFC_COUNT=$(find .agent-rfc -maxdepth 1 -name "*.md" -type f 2>/dev/null | wc -l | tr -d ' ')
  if [ "${RFC_COUNT:-0}" -eq 0 ]; then
    echo "❌ ERROR: Enterprise policy requires at least one RFC under .agent-rfc/ before committing."
    echo "   Create one: touch .agent-rfc/NNN-short-description.md (see docs/UserManual.md › Writing Agent Specifications (RFCs))."
    FAILED=1
  fi
fi

if [ "$FAILED" -ne 0 ]; then
  echo "────────────────────────────────────────────────"
  echo "🛑 Pre-commit guardrail failed. Fix issues above."
  echo "   Bypass (emergency only): DISABLE_AI_STACK=true git commit — refused where an org policy forbids it"
  exit 1
fi

echo "✅ Pre-commit guardrails passed."
exit 0
