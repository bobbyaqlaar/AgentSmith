#!/usr/bin/env bash
# AgentSmith: post-checkout
# Provisions IDE rules, Antigravity skills, CI workflows, Knowledge Graph.
# Fires on: git checkout, git clone. NOT on `git init` — git does not run
# post-checkout for init, so the no-HEAD branch below is reached via the
# first checkout of a fresh repo, not at init time. A new project is
# provisioned by opting in and running `git checkout` (see the gate
# message), or by `ai-tenant-init`.

if [ "${DISABLE_AI_STACK:-false}" = "true" ]; then exit 0; fi

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
[ -z "$REPO_ROOT" ] && exit 0

# ── Developer opt-in gate for PRE-EXISTING repos (SPECS.md §7) ────────────────
# Global init.templateDir installs these hooks into every repo on the
# machine, including a third-party project someone just `git clone`'d. A
# repo that already has commit history and has never opted in is not ours
# to provision — writing .cursorrules/CI workflows/.gitignore entries into
# it would pollute someone else's project. A brand-new `git init` (no HEAD
# yet) or an already-opted-in repo (.agenticframework/ marker or
# tenant.yaml, possibly committed) provisions normally.
if git rev-parse --verify HEAD >/dev/null 2>&1 \
   && [ ! -f "$REPO_ROOT/.agenticframework/enabled" ] \
   && [ ! -f "$REPO_ROOT/.agenticframework/tenant.yaml" ]; then
  echo "ℹ️  AgentSmith: existing repo, not opted in — skipping provisioning."
  echo "   To opt in: mkdir -p .agenticframework && touch .agenticframework/enabled, then run: git checkout"
  echo "   (plain \`git checkout\` re-fires this hook and keeps your edits — NOT \`git checkout .\`, which discards them)"
  exit 0
fi

FRAMEWORK_DIR="$HOME/.agent-framework"
SCRIPTS_DIR="$FRAMEWORK_DIR/scripts"

# This hook runs Python out of the scripts/ it has just vendored
# (generate-ide-config.py, map_codebase.py), and Python writes
# scripts/__pycache__/*.pyc beside them. A tenant whose .gitignore does not
# already cover Python — any Go or TS repo — then commits bytecode: found in a
# scratch Go tenant's very first commit. Same class as runtime/.hitl_blobs.
export PYTHONDONTWRITEBYTECODE=1

# Keep vendored framework code out of the TENANT's lint/format gates.
#
# ci-python-fastapi.yml runs `ruff check .` and `ruff format --check .` with
# the tenant's config. Vendored runtime/ and scripts/ are held to the
# framework's rules, not the tenant's, and are not the tenant's to fix:
# AqlaarTeleologyStudio's lint step went red on 746 findings, 609 of them in
# vendored code. A nested ruff.toml that `extend`s the tenant's root config and
# `extend-exclude`s exactly the vendored files drops them from both commands
# while the tenant's own files in the same directory keep the tenant's rules —
# verified under ruff 0.15.20 and 0.16.7 with pyproject.toml, ruff.toml and no
# root config. Never written over a config the directory already has.
#   $1 = directory name under the repo root; stdin = vendored paths relative to it
write_vendored_ruff_config() {
  local dir="$REPO_ROOT/$1" extend="" cfg
  for cfg in ruff.toml .ruff.toml pyproject.toml; do
    [ -f "$dir/$cfg" ] && return 0
  done
  if [ -f "$REPO_ROOT/ruff.toml" ]; then extend='extend = "../ruff.toml"'
  elif [ -f "$REPO_ROOT/.ruff.toml" ]; then extend='extend = "../.ruff.toml"'
  elif [ -f "$REPO_ROOT/pyproject.toml" ] && grep -q '^\[tool\.ruff' "$REPO_ROOT/pyproject.toml"; then
    extend='extend = "../pyproject.toml"'
  fi
  {
    echo "# Written by AgentSmith when it vendored $1/ — see hooks/post-checkout."
    echo "# Excludes the vendored files from this repo's ruff check/format; your own"
    echo "# files here keep your rules. ai-stack-upgrade regenerates this file."
    [ -n "$extend" ] && echo "$extend"
    echo "extend-exclude = ["
    sort | sed 's/"/\\"/g; s/.*/  "&",/'
    echo "]"
  } > "$dir/ruff.toml"
}

# ── Detect stack ──────────────────────────────────────────────────────────────
STACK="GENERIC"
TEST_CMD="echo 'No test command configured'"

# TEST_CMD goes into the generated agent rules, so it names the tool the
# project actually uses — the lockfile says which, in the SAME precedence as
# ci-ts-react.yml's "Detect package manager" step and the install-python-deps
# action (scripts/test/test_ci_package_managers.py runs both sides and pins
# them). Yarn and bun get their own tool here even though the TS template
# rejects them: this line tells an agent how to run tests locally.
if [ -f "$REPO_ROOT/package.json" ]; then
  STACK="TS_REACT"
  if [ -f "$REPO_ROOT/pnpm-lock.yaml" ]; then js=pnpm
  elif [ -f "$REPO_ROOT/package-lock.json" ] || [ -f "$REPO_ROOT/npm-shrinkwrap.json" ]; then js=npm
  elif [ -f "$REPO_ROOT/yarn.lock" ]; then js=yarn
  elif [ -f "$REPO_ROOT/bun.lock" ] || [ -f "$REPO_ROOT/bun.lockb" ]; then js=bun
  else js=npm
  fi
  # `bun test` is bun's own runner, not the package's test script.
  if [ "$js" = bun ]; then TEST_CMD="CI=true bun run test"; else TEST_CMD="CI=true $js test"; fi
elif [ -f "$REPO_ROOT/requirements.txt" ] || [ -f "$REPO_ROOT/pyproject.toml" ] || [ -f "$REPO_ROOT/Pipfile" ]; then
  STACK="PYTHON_FASTAPI"; TEST_CMD="pytest"
  if [ ! -f "$REPO_ROOT/requirements.txt" ] && [ -f "$REPO_ROOT/uv.lock" ]; then TEST_CMD="uv run pytest"; fi
elif [ -f "$REPO_ROOT/go.mod" ]; then
  STACK="GO"; TEST_CMD="go test -race ./..."
fi

echo "🔧 AgentSmith: Detected stack [$STACK]"

# ── Installed-runtime tenants are not vendored into ───────────────────────────
# Two ways to consume AgentSmith, and this hook used to assume only one. A
# tenant that declares `agentsmith-runtime` as a dependency (KYC Sentinel pins
# `agentsmith-runtime @ git+https://…@v1.3.0`) runs the harness from a
# framework checkout in its own CI and imports the runtime it pinned. Vendoring
# into it does damage, verified on a hook-free clone of KYC Sentinel: runtime/
# at the repo root SHADOWS the pinned package for every script run from there
# (demo.py, worker.py), silently replacing v1.3.0 with whatever this machine
# has installed; 44 framework scripts land in its own scripts/; and seven
# generated workflows appear — cd-production.yml among them — built for the
# vendored layout it does not have. Such a tenant gets IDE rules, the security
# pack and the Knowledge Graph, and nothing that assumes vendoring.
INSTALLED_RUNTIME=0
if grep -qsE '^[[:space:]"'"'"']*agentsmith-runtime' "$REPO_ROOT"/requirements*.txt "$REPO_ROOT/pyproject.toml" 2>/dev/null \
   && ! grep -qs '^name = "agentsmith-runtime"' "$REPO_ROOT/pyproject.toml"; then
  INSTALLED_RUNTIME=1
  echo "ℹ️  This repo depends on agentsmith-runtime as a package — installed mode:"
  echo "   scripts/, runtime/ and fixtures/ are NOT vendored, and the generated CI/CD workflows are NOT written"
  echo "   (they assume vendored scripts/). Run the harness from a framework checkout, as KYC Sentinel's ci.yml does."
fi

# ── Create .agent-rfc/ structure ─────────────────────────────────────────────
mkdir -p "$REPO_ROOT/.agent-rfc/fixtures"

# ── Seed golden dataset from framework base ───────────────────────────────────
GOLDEN_FILE="$REPO_ROOT/.agent-rfc/fixtures/golden_evals.json"
if [ ! -f "$GOLDEN_FILE" ] && [ -f "$FRAMEWORK_DIR/shared/golden_evals_base.json" ]; then
  cp "$FRAMEWORK_DIR/shared/golden_evals_base.json" "$GOLDEN_FILE"
  echo "✅ Seeded baseline golden dataset"
fi

# Seed judge criteria
CRITERIA_FILE="$REPO_ROOT/.agent-rfc/fixtures/custom_judge_criteria.json"
if [ ! -f "$CRITERIA_FILE" ] && [ -f "$FRAMEWORK_DIR/shared/custom_judge_criteria_base.json" ]; then
  cp "$FRAMEWORK_DIR/shared/custom_judge_criteria_base.json" "$CRITERIA_FILE"
  echo "✅ Seeded baseline judge criteria"
fi

# ── Seed .agent-rfc/security/ pack from framework templates ──────────────────
# The SEC-* harness looks for these four artifacts in every tenant repo, but
# nothing used to put them there — so a new tenant started with those controls
# skipping/failing and had to discover fixtures/security/templates/ by reading
# the framework tree (TestbedFeedback-2026-07-21 G5).
#
# Seeded, never overwritten: a filled-in risk register is the tenant's own
# document (its content is exactly what the framework CANNOT know), so a
# later checkout must never clobber it. Same guard as the golden dataset.
SECURITY_TEMPLATES="$FRAMEWORK_DIR/shared/security"
if [ -d "$SECURITY_TEMPLATES" ]; then
  mkdir -p "$REPO_ROOT/.agent-rfc/security"
  SEEDED_SECURITY=0
  for TEMPLATE in "$SECURITY_TEMPLATES"/*.yaml; do
    [ -f "$TEMPLATE" ] || continue
    TARGET="$REPO_ROOT/.agent-rfc/security/$(basename "$TEMPLATE")"
    if [ ! -f "$TARGET" ]; then
      cp "$TEMPLATE" "$TARGET"
      SEEDED_SECURITY=$((SEEDED_SECURITY + 1))
    fi
  done
  if [ "$SEEDED_SECURITY" -gt 0 ]; then
    echo "✅ Seeded $SEEDED_SECURITY security artifact(s) into .agent-rfc/security/"
    echo "   ⚠️  These are PLACEHOLDERS — edit them before promoting to production:"
    echo "      risk_register.yaml   your real residual risks and owners"
    echo "      agency_manifest.yaml your high-impact actions requiring HITL"
    echo "      tool_allowlist.yaml  your registered tool names (deny-by-default)"
    echo "      nist_profile.yaml    your org name and control owners"
    echo "   Verify with: python3 scripts/run-security-checks.py --mode ci --strict"
  fi
else
  # Silently skipping left a tenant with no pack and a harness that fails
  # SEC-TOOL-001/SEC-RISK-001 on files nobody said were missing.
  echo "⚠️  $SECURITY_TEMPLATES missing — .agent-rfc/security/ was not seeded. Re-run install-ai-stack.sh."
fi

# ── Vendor scripts/ from the framework ────────────────────────────────────────
# Found onboarding AqlaarTeleologyStudio: every generated CI workflow calls
# `python3 scripts/<name>.py` directly from the tenant's OWN repo — not
# through this hook's own fallback-to-$SCRIPTS_DIR logic below, which only
# covers this invocation's own calls (generate-ide-config.py, map_codebase.py)
# and nothing a GitHub Actions runner or a collaborator's machine with no
# ~/.agent-framework does later. Nothing ever copied scripts/ itself into the
# tenant, so every one of those calls failed with "No such file" — mostly
# silently, since most of those CI steps are non-blocking.
#
# Seeded once, like the other tenant-owned artifacts above: a tenant may
# patch a vendored script, and a routine `git checkout` firing this hook must
# not silently clobber that. Pulling in newer framework scripts later is
# `ai-stack-upgrade`'s job, deliberately (same $SCRIPTS_DIR source, same
# test/-and-__pycache__ exclusion as of this change) — this only covers the
# case where scripts/ has never existed in the tenant at all.
#
# "Already vendored" is decided by a framework file, not by scripts/ existing.
# A scripts/ directory is ordinary in JS and Go repos — found onboarding a
# scratch create-vite tenant whose scripts/release.mjs made this step skip
# SILENTLY, leaving every scripts/*.py CI call to fail. Such a directory is
# merged into without overwriting anything, from a pruned staging copy: pruning
# test/ AFTER copying would delete the tenant's own scripts/test/.
if [ "$INSTALLED_RUNTIME" -eq 0 ] && [ ! -f "$REPO_ROOT/scripts/run-security-checks.py" ]; then
  if [ -d "$SCRIPTS_DIR" ] && [ -n "$(ls -A "$SCRIPTS_DIR" 2>/dev/null)" ]; then
    PRE_EXISTING_SCRIPTS=0
    [ -d "$REPO_ROOT/scripts" ] && PRE_EXISTING_SCRIPTS=1
    STAGE=$(mktemp -d)
    cp -r "$SCRIPTS_DIR/." "$STAGE/"
    # The framework's own test suite and fixtures (~2MB) — a tenant runs its
    # own tests, not AgentSmith's, and has no use for them.
    rm -rf "$STAGE/test"
    find "$STAGE" -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true
    mkdir -p "$REPO_ROOT/scripts"
    CLASHES=""
    WRITTEN=""
    while IFS= read -r REL; do
      REL="${REL#./}"
      if [ -e "$REPO_ROOT/scripts/$REL" ]; then
        CLASHES="$CLASHES $REL"
      else
        mkdir -p "$(dirname "$REPO_ROOT/scripts/$REL")"
        cp "$STAGE/$REL" "$REPO_ROOT/scripts/$REL"
        WRITTEN="$WRITTEN$REL"$'\n'
      fi
    done < <(cd "$STAGE" && find . -type f)
    rm -rf "$STAGE"
    printf '%s' "$WRITTEN" | grep -v '^$' | write_vendored_ruff_config scripts
    VENDORED_COUNT=$(find "$REPO_ROOT/scripts" -name "*.py" | wc -l | tr -d ' ')
    if [ "$PRE_EXISTING_SCRIPTS" -eq 1 ]; then
      echo "✅ Vendored scripts/ from $SCRIPTS_DIR into the existing scripts/ ($VENDORED_COUNT .py files; nothing of yours overwritten)"
    else
      echo "✅ Vendored scripts/ from $SCRIPTS_DIR ($VENDORED_COUNT files)"
    fi
    if [ -n "$CLASHES" ]; then
      echo "⚠️  scripts/ already had files with framework names — kept yours, framework copies NOT written:$CLASHES"
      echo "   CI steps that call these expect AgentSmith's versions. Rename yours if they are unrelated."
    fi
  else
    echo "⚠️  ~/.agent-framework/scripts/ missing — scripts/ not vendored. Every scripts/*.py call in .github/workflows/*.yml will fail. Re-run install-ai-stack.sh."
  fi
fi

# ── Vendor runtime/ and fixtures/security/ from the framework ────────────────
# Same gap as scripts/ above, found in the same pass: `run-evals.py` and
# `verify_system.py --check-redaction` import `runtime.*`, and
# `run-security-checks.py --mode ci/--strict` reads
# `fixtures/security/control_registry.json` via `_install_root()`, which is
# file-relative and never consults $AGENTSMITH_DIR — so once vendored into a
# tenant, it resolves against the TENANT's own root, not the framework's.
# `pip install agentsmith-runtime` is not a working substitute: confirmed
# against PyPI's own API, no such project is published there.
#
# runtime/test/ is vendored ONLY as far as the security harness needs it: the
# suites its controls delegate to (SEC-HITL/DLQ/BUDGET/SELF-001) and the
# conftest.py they run under. It used to be vendored whole, on the reasoning
# that those suites are infra-free library evidence. The other 50-odd files
# are not: a scratch python-fastapi tenant's template `pytest` collected them
# and went red on 36 failures — framework-relative paths (pyproject.toml,
# examples/, the framework-root guard), psycopg2, and the tenant's own posture
# leaking into tests written for the framework's. Those suites run in
# AgentSmith's own CI. TENANT_RUNTIME_TESTS is pinned to the harness's
# pytest_suite() bindings by scripts/test/test_workflow_template_wiring.py.
TENANT_RUNTIME_TESTS=(conftest.py test_hitl_gate.py test_dead_letter.py test_llm_gateway_budget.py test_self_correction.py)
if [ "$INSTALLED_RUNTIME" -eq 1 ]; then
  :  # see "Installed-runtime tenants" above
elif [ -d "$REPO_ROOT/runtime" ] && [ ! -f "$REPO_ROOT/runtime/llm_gateway.py" ]; then
  # `runtime` is a generic package name (pyproject.toml says as much). A
  # tenant's OWN runtime/ is never merged into: framework modules would import
  # the tenant's same-named ones and both would break. Said loudly, because
  # the consequence is every `runtime.*` import in scripts/ resolving to the
  # wrong package.
  echo "⚠️  runtime/ exists and is not AgentSmith's — NOT vendored. scripts/ imports runtime.* (run-evals.py, the security harness) and will load YOUR package instead. Rename yours, or install AgentSmith's runtime as a package."
elif [ ! -d "$REPO_ROOT/runtime" ]; then
  RUNTIME_DIR="$FRAMEWORK_DIR/runtime"
  if [ -d "$RUNTIME_DIR" ] && [ -n "$(ls -A "$RUNTIME_DIR" 2>/dev/null)" ]; then
    mkdir -p "$REPO_ROOT/runtime"
    cp -r "$RUNTIME_DIR/." "$REPO_ROOT/runtime/"
    find "$REPO_ROOT/runtime" -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true
    # Local HITL-gate test-run scratch data — gitignored at the source, but a
    # plain `cp -r` doesn't know that. Committed once into a real tenant
    # before this exclusion existed; never again.
    rm -rf "$REPO_ROOT/runtime/.hitl_blobs"
    rm -rf "$REPO_ROOT/runtime/test"
    mkdir -p "$REPO_ROOT/runtime/test"
    for SUITE in "${TENANT_RUNTIME_TESTS[@]}"; do
      [ -f "$RUNTIME_DIR/test/$SUITE" ] && cp "$RUNTIME_DIR/test/$SUITE" "$REPO_ROOT/runtime/test/$SUITE"
    done
    (cd "$REPO_ROOT/runtime" && find . -type f | sed 's|^\./||') | write_vendored_ruff_config runtime
    echo "✅ Vendored runtime/ from $RUNTIME_DIR"
  else
    echo "⚠️  ~/.agent-framework/runtime/ missing — runtime/ not vendored. Any script importing runtime.* will fail with ModuleNotFoundError. Re-run install-ai-stack.sh."
  fi
fi

if [ "$INSTALLED_RUNTIME" -eq 0 ] && [ ! -d "$REPO_ROOT/fixtures/security" ]; then
  FIXTURES_SECURITY_DIR="$FRAMEWORK_DIR/fixtures/security"
  if [ -d "$FIXTURES_SECURITY_DIR" ] && [ -n "$(ls -A "$FIXTURES_SECURITY_DIR" 2>/dev/null)" ]; then
    mkdir -p "$REPO_ROOT/fixtures"
    cp -r "$FIXTURES_SECURITY_DIR" "$REPO_ROOT/fixtures/security"
    echo "✅ Vendored fixtures/security/ from $FIXTURES_SECURITY_DIR"
  else
    echo "⚠️  ~/.agent-framework/fixtures/security/ missing — fixtures/security/ not vendored. run-security-checks.py --mode ci/--strict will crash on a missing control_registry.json. Re-run install-ai-stack.sh."
  fi
fi

# ── Vendor fixtures/*_base.json ───────────────────────────────────────────────
# run-evals.py falls back to these (file-relative, like control_registry.json)
# when a tenant has no suite file of its own, "so a fresh tenant gates on
# something rather than skipping". Never vendored, so in a tenant that fallback
# found nothing: SEC-RAG-001 failed `need ≥3 rag_poison cases, found 0`
# (AqlaarTeleologyStudio), and the fairness/hallucination suites loaded zero
# cases and skipped. Per FILE and never overwritten, not a directory copy: a
# tenant's own fixtures/ (KYC Sentinel keeps applicants.json there) is theirs.
if [ "$INSTALLED_RUNTIME" -eq 0 ] && ls "$FRAMEWORK_DIR"/fixtures/*_base.json >/dev/null 2>&1; then
  SEEDED_BASE=0
  for BASE in "$FRAMEWORK_DIR"/fixtures/*_base.json; do
    TARGET="$REPO_ROOT/fixtures/$(basename "$BASE")"
    if [ ! -f "$TARGET" ]; then
      mkdir -p "$REPO_ROOT/fixtures"
      cp "$BASE" "$TARGET"
      SEEDED_BASE=$((SEEDED_BASE + 1))
    fi
  done
  [ "$SEEDED_BASE" -gt 0 ] && echo "✅ Vendored $SEEDED_BASE base eval fixture(s) into fixtures/"
fi

# ── Resolve project name and owner ────────────────────────────────────────────
PROJECT_NAME=$(git remote get-url origin 2>/dev/null | sed 's/.*\///' | sed 's/\.git$//' || basename "$REPO_ROOT")
OWNER_ID="${AGENT_OWNER_ID:-unknown@unknown}"
OTEL_ENDPOINT="${AGENT_PHOENIX_ENDPOINT:-http://localhost:6006}"

# ── Generate .cursorrules / CLAUDE.md / Antigravity skills ───────────────────
# Single source of truth: templates/agent-rules.yaml (SPECS.md §4, §13, §22
# Phase 5). Never edit .cursorrules/CLAUDE.md/.agents/skills/ directly or add
# new IDE-rule content as inline heredocs here — edit agent-rules.yaml.
RULES_FILE="$FRAMEWORK_DIR/templates/agent-rules.yaml"
case "$STACK" in
  TS_REACT)       RULES_STACK_KEY="ts-react" ;;
  PYTHON_FASTAPI) RULES_STACK_KEY="python-fastapi" ;;
  GO)             RULES_STACK_KEY="go" ;;
  *)              RULES_STACK_KEY="generic" ;;
esac

GEN_SCRIPT="$REPO_ROOT/scripts/generate-ide-config.py"
[ ! -f "$GEN_SCRIPT" ] && GEN_SCRIPT="$SCRIPTS_DIR/generate-ide-config.py"

if [ -f "$RULES_FILE" ] && [ -f "$GEN_SCRIPT" ]; then
  python3 "$GEN_SCRIPT" \
    --repo-root "$REPO_ROOT" \
    --rules-file "$RULES_FILE" \
    --stack "$RULES_STACK_KEY" \
    --project-name "$PROJECT_NAME" \
    --owner-id "$OWNER_ID" \
    --otel-endpoint "$OTEL_ENDPOINT" \
    --test-cmd "$TEST_CMD" \
    --framework-version "${FRAMEWORK_VERSION:-1.0.0}" || \
    echo "⚠️  IDE config generation failed — see error above. .cursorrules/CLAUDE.md/.agents/skills/ not written."
else
  echo "⚠️  agent-rules.yaml or generate-ide-config.py not found — IDE config not generated. Re-run install-ai-stack.sh."
fi

# ── GitHub Actions — copy from workflow-templates (single source, SPECS.md §17) ─
# Same templates ai-tenant-init uses — no inline heredocs here (they drifted).
TMPL_DIR="$FRAMEWORK_DIR/workflow-templates"
GITHUB_WF="$REPO_ROOT/.github/workflows"

TENANT_ID=""
if [ -f "$REPO_ROOT/.agenticframework/tenant.yaml" ]; then
  TENANT_ID="$(grep '^  id:' "$REPO_ROOT/.agenticframework/tenant.yaml" | head -1 | sed 's/^  id:[[:space:]]*//')"
fi
if [ -z "$TENANT_ID" ]; then
  TENANT_ID="$(echo "$PROJECT_NAME" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]/-/g' | sed 's/--*/-/g' | sed 's/^-//;s/-$//')"
fi
if ! [[ "$TENANT_ID" =~ ^[a-z0-9-]+$ ]] || [ -z "$TENANT_ID" ]; then
  TENANT_ID="project"
fi

WF_CI=""
case "$STACK" in
  TS_REACT)       WF_CI="ci-ts-react.yml" ;;
  PYTHON_FASTAPI) WF_CI="ci-python-fastapi.yml" ;;
  GO)             WF_CI="ci-go.yml" ;;
esac

if [ -f "$GITHUB_WF/cd-deploy.yml" ]; then
  echo "⚠️  Legacy cd-deploy.yml found — remove it and use cd-staging.yml + cd-production.yml (OPERATIONS.md §C)."
fi

if [ "$INSTALLED_RUNTIME" -eq 0 ] && [ -d "$TMPL_DIR" ] && [ -n "$WF_CI" ]; then
  mkdir -p "$GITHUB_WF"
  # eval-fairness/eval-hallucination/eval-ttft-live/eval-security are
  # referenced by every ci-<stack>.yml as `uses: ./.github/workflows/<name>`
  # — a missing callee makes GitHub reject the whole CI workflow as invalid,
  # so they ship together with the caller.
  #
  # This list must match runtime/cli.py's WORKFLOWS tuple exactly (that
  # Python implementation is the one `agentsmith tenant init` delegates to;
  # this bash array is what actually fires for a checkout). eval-security.yml
  # was added to WORKFLOWS and to ci-python-fastapi.yml's job list without
  # being added here — found onboarding AqlaarTeleologyStudio, whose
  # ci-python-fastapi.yml GitHub rejected outright as an invalid workflow
  # because of it. scripts/test/test_workflow_template_parity.py pins the two
  # lists against each other so this can't drift silently again.
  for wf in "$WF_CI" "cd-staging.yml" "cd-production.yml" "eval-scorecard.yml" \
            "eval-fairness.yml" "eval-hallucination.yml" "eval-ttft-live.yml" \
            "eval-security.yml"; do
    src="$TMPL_DIR/$wf"
    dest="$GITHUB_WF/$wf"
    if [ ! -f "$src" ]; then
      echo "⚠️  Workflow template missing, skipping: $src"
      continue
    fi
    if [ -f "$dest" ]; then
      continue
    fi
    sed "s/{{TENANT_ID}}/${TENANT_ID}/g" "$src" > "$dest"
    echo "✅ Written $dest (from workflow-templates)"
  done

  # Composite actions the cd-* workflows call as `uses: ./.github/actions/<name>`
  # — resolved inside THIS repo, so they must be copied in alongside the
  # workflows (vendored to ~/.agent-framework/github-actions/ by the installer).
  ACTIONS_SRC="$FRAMEWORK_DIR/github-actions"
  if [ -d "$ACTIONS_SRC" ] && [ "$(ls -A "$ACTIONS_SRC" 2>/dev/null)" ]; then
    mkdir -p "$REPO_ROOT/.github/actions"
    for action_dir in "$ACTIONS_SRC"/*/; do
      [ -d "$action_dir" ] || continue
      action_name="$(basename "$action_dir")"
      if [ -d "$REPO_ROOT/.github/actions/$action_name" ]; then
        continue
      fi
      cp -r "$action_dir" "$REPO_ROOT/.github/actions/$action_name"
      echo "✅ Written .github/actions/$action_name (from github-actions)"
    done
  else
    echo "⚠️  ~/.agent-framework/github-actions/ missing — cd-staging/cd-production reference ./.github/actions/* and will fail. Re-run install-ai-stack.sh."
  fi
elif [ "$STACK" != "GENERIC" ] && [ ! -d "$TMPL_DIR" ]; then
  echo "⚠️  workflow-templates not installed — run install-ai-stack.sh. CI/CD workflows not written."
fi

# ── Update Knowledge Graph ────────────────────────────────────────────────────
# AGENT_KG_DEFER=1 skips the rebuild during batch git operations — see
# hooks/post-commit for the full rationale (ReviewFindings-2026-07-18 C2).
if [ "${AGENT_KG_DEFER:-0}" != "1" ]; then
  MAP_SCRIPT="$REPO_ROOT/scripts/map_codebase.py"
  [ ! -f "$MAP_SCRIPT" ] && MAP_SCRIPT="$SCRIPTS_DIR/map_codebase.py"
  if [ -f "$MAP_SCRIPT" ]; then
    python3 "$MAP_SCRIPT" 2>/dev/null && echo "✅ Knowledge Graph seeded" || true
  fi
fi

# ── .gitignore for public repos ───────────────────────────────────────────────
REMOTE_URL=$(git remote get-url origin 2>/dev/null || echo "")
IS_PUBLIC=0

# Real visibility via `gh` when available (SPECS.md §20); if gh is missing,
# unauthenticated, or the lookup fails, fall back to treating any github.com
# remote as potentially public — the safe direction, since the consequence
# is only a .gitignore prompt (or a conservative auto-append in CI).
if echo "$REMOTE_URL" | grep -q "github.com"; then
  IS_PUBLIC=1
  if command -v gh >/dev/null 2>&1; then
    REPO_SLUG=$(echo "$REMOTE_URL" | sed -E 's#^(git@github\.com:|https://github\.com/)##; s#\.git$##')
    VISIBILITY=$(gh repo view "$REPO_SLUG" --json visibility --jq .visibility 2>/dev/null || echo "")
    case "$VISIBILITY" in
      PRIVATE|private|INTERNAL|internal) IS_PUBLIC=0 ;;
    esac
  fi
fi

# Once per repo, not once per checkout. This block had no "already there?"
# check, so every checkout of a repo whose visibility could not be confirmed
# appended another copy — and prompted again. Found in the scratch tenants:
# their .gitignore files carried the block up to three times over.
IDE_IGNORE_MARKER="# AgentSmith — IDE configs (system prompt content)"
if [ "$IS_PUBLIC" -eq 1 ] && grep -qxF "$IDE_IGNORE_MARKER" "$REPO_ROOT/.gitignore" 2>/dev/null; then
  IS_PUBLIC=0   # already handled for this repo; nothing to ask or append
fi

if [ "$IS_PUBLIC" -eq 1 ] && [ -t 1 ]; then
  echo ""
  echo "⚠️  This repository appears to be public."
  echo "   .cursorrules, CLAUDE.md, AGENTS.md, GEMINI.md,"
  echo "   .github/copilot-instructions.md and .agents/ contain system prompt content."
  read -r -p "   Add them to .gitignore? (y/n): " GITIGNORE_CHOICE
  if [[ "${GITIGNORE_CHOICE:-y}" =~ ^[Yy]$ ]]; then
    GITIGNORE="$REPO_ROOT/.gitignore"
    {
      echo ""
      echo "# AgentSmith — IDE configs (system prompt content)"
      echo ".cursorrules"
      echo "CLAUDE.md"
      echo "AGENTS.md"
      echo "GEMINI.md"
      echo ".github/copilot-instructions.md"
      echo ".agents/"
      echo ".agent-history.log"
    } >> "$GITIGNORE"
    echo "✅ Added IDE config files to .gitignore"
  fi
elif [ "$IS_PUBLIC" -eq 1 ]; then
  # Non-interactive (CI): auto-add to .gitignore — and say so; this used to be
  # entirely silent, so a repo could stop tracking CLAUDE.md with no trace.
  GITIGNORE="$REPO_ROOT/.gitignore"
  echo "ℹ️  Could not confirm this repo is private — added IDE config files to .gitignore"
  {
    echo ""
    echo "# AgentSmith — IDE configs (system prompt content)"
    echo ".cursorrules"
    echo "CLAUDE.md"
    echo "AGENTS.md"
    echo "GEMINI.md"
    echo ".github/copilot-instructions.md"
    echo ".agents/"
    echo ".agent-history.log"
  } >> "$GITIGNORE"
fi

# ── Write the developer opt-in marker (FIXES_AND_CLEANUP.md P1a) ────────────
# Reached only for a brand-new `git init` (no HEAD) or an already-opted-in
# repo — the gate at the top of this hook skips pre-existing repos that
# never opted in, so a totally unrelated repo someone just `git clone`'d is
# never provisioned or opted in behind their back. Writing the marker here
# is what makes pre-commit/commit-msg/post-commit enforce in THIS repo from
# now on (they no-op without it), exactly as documented in UserManual.md §3.
if [ ! -f "$REPO_ROOT/.agenticframework/enabled" ] && [ ! -f "$REPO_ROOT/.agenticframework/tenant.yaml" ]; then
  mkdir -p "$REPO_ROOT/.agenticframework"
  touch "$REPO_ROOT/.agenticframework/enabled"
fi

echo ""
echo "✅ AgentSmith: Project provisioned for [$STACK] — $(basename "$REPO_ROOT")"
exit 0
